# Copia este archivo a .env y rellena solo lo necesario. NUNCA subas .env al repositorio.
# Ruta del terminal MT5 (opcional; si se omite, el paquete MetaTrader5 busca el terminal abierto)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Login de la cuenta DEMO (opcional: si el terminal ya tiene la sesión abierta no hace falta)
MT5_LOGIN=
MT5_SERVER=Exness-MT5Trial11
# La contraseña no se guarda aquí; inicia sesión en el terminal a mano.
